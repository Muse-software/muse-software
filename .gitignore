# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.claude

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# form submission logs (contains visitor PII — never commit)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
.playwright-cli/
.playwright-mcp/

# screenshots
*.png
# ...but the generated Open Graph cards are build artefacts the site serves,
# not screenshots. Regenerate with `node scripts/build-og-image-ar.mjs`.
!/public/og/*.png

# ─── Company assets ───────────────────────────────────────────────────────────
# The vault's notes ARE tracked — they're the company's written thinking and
# belong in version control. Only the heavy binary sources are excluded.

# Brand design sources. The Illustrator file is 268 MB, well past GitHub's
# 100 MB per-file hard limit, so a push carrying it would be rejected outright.
/brand-assets/*.ai
/brand-assets/*.pdf
/brand-assets/*.zip
/brand-assets/*.mp4
# Four deck-page exports are 2–38 MB each; the logo and element SVGs stay tracked.
/brand-assets/Export/SVG/Powerpoint-0[5-8].svg

# Vault attachments: the 71 MB brand guideline PDF (duplicate of the one in
# brand-assets). The 140 KB explainer PDF stays tracked.
/Muse Vault/99 Meta/Attachments/*.pdf
# Per-machine Obsidian UI state — churns on every open, means nothing to anyone else.
/Muse Vault/.obsidian/workspace*.json

# Screenshots pasted into notes would otherwise vanish into the *.png rule above.
!/Muse Vault/**/*.png
