# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.claude

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# form submission logs (contains visitor PII — never commit)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
.playwright-cli/
.playwright-mcp/

# screenshots
*.png
# ...but the generated Open Graph cards are build artefacts the site serves,
# not screenshots. Regenerate with `node scripts/build-og-image-ar.mjs`.
!/public/og/*.png

# Company assets
# The Illustrator file is 268 MB and exceeds GitHub's per-file limit.
/brand-assets/*.ai
/brand-assets/*.pdf
/brand-assets/*.zip
/brand-assets/*.mp4
/brand-assets/Export/SVG/Powerpoint-0[5-8].svg

# Private company knowledge belongs outside this public repository.
/Muse Vault/

assets/screens/

.next-production/
docs/experience-rebuild/screenshots/
docs/experience-rebuild/*-evidence/
.next-directions/
.next-directions-release/
docs/creative-directions/screenshots/
docs/creative-directions/*-evidence/

docs/creative-directions/evidence-review-*/

.next-premium-dev/
.next-premium-release/
docs/creative-directions/premium-evidence/

/premium-evidence/

.next-mosaic-dev/
.next-mosaic-release/
docs/mosaic/evidence/

/mosaic-evidence/

.next-muse-dev/
.next-muse-release/
docs/mosaic-launch/evidence/

# Local review captures and tests are never release assets.
/test-results/
/private/
/.private/
/docs/internal/
# Retired company/design source stays outside this public repository.
/brand-assets/
/assets/
/archive/
/site-structure-src/
/walkthrough-src/
/Muse-Site-*.pdf
