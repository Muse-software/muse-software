# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.claude

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# form submission logs (contains visitor PII — never commit)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
.playwright-cli/
.playwright-mcp/

# screenshots
*.png
# ...but the generated Open Graph cards are build artefacts the site serves,
# not screenshots. Regenerate with `node scripts/build-og-image-ar.mjs`.
!/public/og/*.png

# Company assets
# The Illustrator file is 268 MB and exceeds GitHub's per-file limit.
/brand-assets/*.ai
/brand-assets/*.pdf
/brand-assets/*.zip
/brand-assets/*.mp4
/brand-assets/Export/SVG/Powerpoint-0[5-8].svg

# Muse company knowledge is private and canonical in:
# https://github.com/alsubaieabdullah/muse-documentation-vault
# Never recreate or copy the private vault into this public repository.
/Muse Vault/

assets/screens/
