# Copy to .env (git-ignored) and fill in. next.config.ts refuses to start without them.

# Public contact address used by every mailto link, the footer, careers and legal pages.
# Inlined into the client bundle at build time: rebuild after changing it.
CONTACT_EMAIL=info@muse.sa

# Signs captcha tokens and hashes stored IP addresses. Server-only.
# Generate with: openssl rand -base64 48
CAPTCHA_SECRET=

# Storage: "disk" writes one JSON file per enquiry (default locally); "none" stores nothing and the
# team email is the only copy (default on Vercel, whose filesystem is read-only).
# SUBMISSIONS_STORAGE=disk
# Where disk mode writes (default: ./data/submissions).
# SUBMISSIONS_DIR=/var/lib/muse/submissions

# Enquiry notification email, sent through Microsoft Graph as a Microsoft 365 mailbox.
# Leave MS_* empty for dry-run mode (the email is logged, not sent).
MAIL_FROM=noreply@muse.sa
# Defaults to CONTACT_EMAIL. MAIL_TO and MAIL_CC accept comma-separated lists.
MAIL_TO=info@muse.sa
MAIL_CC=abdullah@muse.sa,aamir@muse.sa
# Entra app registration with Graph application permission Mail.Send (admin consented),
# restricted to MAIL_FROM with an Exchange Application Access Policy. Server-only.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Rate limiting reads the client IP from X-Forwarded-For. Set this to the number of
# reverse proxies in front of the app (nginx = 1; Cloudflare + nginx = 2). Default 1.
# TRUSTED_PROXY_HOPS=1
