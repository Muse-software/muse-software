{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // gsap's own `types/index.d.ts` references `flip.d.ts` (lowercase) via a
    // triple-slash directive, but the only subpath that resolves `Flip` at
    // runtime is the capitalized `gsap/Flip` (matching `Flip.js` on disk) —
    // TS's default case-consistency check treats those as two different
    // files with the same on-disk identity and fails the build. This is an
    // upstream gsap packaging inconsistency (confirmed: no lowercase
    // `Flip.js` exists, so importing `gsap/flip` to "fix" the casing would
    // 404 on any case-sensitive production filesystem), not a real casing bug
    // in this repo's own source.
    "forceConsistentCasingInFileNames": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "archive"]
}
